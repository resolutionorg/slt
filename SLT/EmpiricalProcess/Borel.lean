/-!
# The Borel σ-algebra of `C(U, ℝ)` and finite-dimensional distributions

| Thesis | Lean |
| --- | --- |
| [Hit26, Lemma 4.1.5] | |
| | `borel_eq_generateFrom_cylinders`, `ContinuousMap.measurable_of_eval` |
| [Hit26, Lemma 4.1.2], for the cylinder sets |
`MeasureTheory.Measure.ext_of_fdd` |

`U` is a compact metric space ([Hit26]'s compact `W ⊆ ℝ^d`, the disjoint union of the chart
cubes of a resolution, or `{K ≥ δ}`), `C(U, ℝ)` carries the uniform topology and its Borel
σ-algebra (`SLT/EmpiricalProcess/Defs.lean`). The finite-dimensional measurable sets
`π⁻¹(A)`, `π(h) = (h(u₁), …, h(u_M))`, are the `cylinders`; they form a π-system generating the
Borel σ-algebra, so a map into `C(U, ℝ)` is measurable as soon as every evaluation is, and a
probability measure on `C(U, ℝ)` is determined by its finite-dimensional distributions.
-/

public section

namespace ContinuousMap

open SingularLearningTheory

open MeasureTheory Set Filter Topology

section Cylinders

variable {U : Type*} [TopologicalSpace U]

/-- The finite evaluation map `π(h) = (h(u₁), …, h(u_M))` of [Hit26]. -/
@[expose] def finiteEval {M : ℕ} (u : Fin M → U) (h : C(U, ℝ)) : Fin M → ℝ := fun j ↦ h (u j)

theorem continuous_finiteEval {M : ℕ} (u : Fin M → U) : Continuous (finiteEval u) :=
  continuous_pi fun j ↦ continuous_eval_const (u j)

theorem measurable_finiteEval {M : ℕ} (u : Fin M → U) : Measurable (finiteEval u) :=
  (continuous_finiteEval u).measurable

/-- The finite-dimensional measurable sets `π⁻¹(A)` of [Hit26,
Lemma 4.1.5]. -/
private def cylinders (U : Type*) [TopologicalSpace U] : Set (Set C(U, ℝ)) :=
  {s | ∃ (M : ℕ) (u : Fin M → U) (A : Set (Fin M → ℝ)), MeasurableSet A ∧ s = finiteEval u ⁻¹' A}

private theorem isPiSystem_cylinders : IsPiSystem (cylinders U) := by
  rintro _ ⟨M, u, A, hA, rfl⟩ _ ⟨M', u', A', hA', rfl⟩ -
  refine ⟨M + M', Fin.append u u',
    {y | (fun i ↦ y (Fin.castAdd M' i)) ∈ A ∧ (fun i ↦ y (Fin.natAdd M i)) ∈ A'}, ?_, ?_⟩
  · exact (hA.preimage (Measurable.of_eval fun i ↦ measurable_pi_apply _)).inter
      (hA'.preimage (Measurable.of_eval fun i ↦ measurable_pi_apply _))
  · ext h
    simp only [mem_inter_iff, mem_preimage, mem_ofPred_eq, finiteEval, Fin.append_left,
      Fin.append_right]
    exact Iff.rfl

private theorem measurableSet_of_mem_cylinders {s : Set C(U, ℝ)} (hs : s ∈ cylinders U) :
    MeasurableSet s := by
  obtain ⟨M, u, A, hA, rfl⟩ := hs
  exact hA.preimage (measurable_finiteEval u)

end Cylinders

variable {U : Type*} [MetricSpace U] [CompactSpace U]

/-- The topology of a pseudometric space is generated by the open balls. -/
theorem _root_.PseudoMetricSpace.eq_generateFrom_ball {Y : Type*} [PseudoMetricSpace Y] :
    (inferInstance : TopologicalSpace Y)
      = TopologicalSpace.generateFrom {s | ∃ (y : Y) (r : ℝ), s = Metric.ball y r} := by
  refine le_antisymm ?_ ?_
  · refine TopologicalSpace.le_generateFrom_iff_subset_isOpen.mpr ?_
    rintro _ ⟨y, r, rfl⟩
    exact Metric.isOpen_ball
  · intro s hs
    rw [Metric.isOpen_iff] at hs
    choose! r hr hball using hs
    have : s = ⋃ y ∈ s, Metric.ball y (r y) := by
      ext z
      simp only [mem_iUnion, exists_prop]
      exact ⟨fun hz ↦ ⟨z, hz, Metric.mem_ball_self (hr z hz)⟩, fun ⟨y, hy, hz⟩ ↦ hball y hy hz⟩
    rw [this]
    refine @isOpen_biUnion _ _ (TopologicalSpace.generateFrom _) _ _ fun y _ ↦ ?_
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨y, r y, rfl⟩

/-- A closed ball of `C(U, ℝ)` is the intersection of the cylinders over a dense set of
evaluation points ([Hit26]'s `⋂_{q ∈ Q} P(q, ε) = B̄(f, ε)`). -/
private theorem closedBall_eq_iInter_eval {D : Set U} (hD : Dense D) (h₀ : C(U, ℝ)) {c : ℝ}
    (hc : 0 ≤ c) :
    Metric.closedBall h₀ c = ⋂ u ∈ D, {h : C(U, ℝ) | dist (h u) (h₀ u) ≤ c} := by
  ext h
  simp only [Metric.mem_closedBall, ContinuousMap.dist_le hc, mem_iInter, mem_ofPred_eq]
  refine ⟨fun H u _ ↦ H u, fun H u ↦ ?_⟩
  have hcl : IsClosed {u : U | dist (h u) (h₀ u) ≤ c} :=
    isClosed_le (continuous_dist.comp (h.continuous.prodMk h₀.continuous)) continuous_const
  exact (hcl.closure_subset_iff.mpr H) (hD.closure_eq ▸ mem_univ u)

/-- An open ball is a countable union of closed balls. -/
private theorem _root_.Metric.ball_eq_iUnion_closedBall_sub {Y : Type*} [PseudoMetricSpace Y]
    (y : Y)
    (r : ℝ) : Metric.ball y r = ⋃ n : ℕ, Metric.closedBall y (r - 1 / (n + 1)) := by
  ext z
  simp only [Metric.mem_ball, mem_iUnion, Metric.mem_closedBall]
  constructor
  · intro hz
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.mpr hz)
    exact ⟨n, by linarith⟩
  · rintro ⟨n, hn⟩
    have : (0 : ℝ) < 1 / (n + 1) := by positivity
    linarith

/-- [Hit26, Lemma 4.1.5]: the cylinder sets
generate the Borel σ-algebra of `C(U, ℝ)`. -/
private theorem borel_eq_generateFrom_cylinders :
    (borel C(U, ℝ)) = MeasurableSpace.generateFrom (cylinders U) := by
  obtain ⟨D, hDc, hD⟩ := TopologicalSpace.exists_countable_dense U
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le fun s hs ↦ ?_)
  · rw [borel_eq_generateFrom_of_subbasis PseudoMetricSpace.eq_generateFrom_ball]
    refine MeasurableSpace.generateFrom_le ?_
    letI : MeasurableSpace C(U, ℝ) := MeasurableSpace.generateFrom (cylinders U)
    rintro _ ⟨h₀, r, rfl⟩
    rw [Metric.ball_eq_iUnion_closedBall_sub]
    refine MeasurableSet.iUnion fun n ↦ ?_
    rcases le_or_gt 0 (r - 1 / (n + 1)) with hc | hc
    · rw [closedBall_eq_iInter_eval hD h₀ hc]
      refine MeasurableSet.biInter hDc fun u _ ↦ ?_
      refine MeasurableSpace.measurableSet_generateFrom
        ⟨1, fun _ ↦ u, {y | dist (y 0) (h₀ u) ≤ r - 1 / (n + 1)}, ?_, ?_⟩
      · exact measurableSet_le ((measurable_pi_apply _).dist measurable_const) measurable_const
      · ext h; simp [finiteEval]
    · rw [Metric.closedBall_eq_empty.mpr hc]
      exact MeasurableSet.empty
  · rw [← BorelSpace.measurable_eq]
    exact measurableSet_of_mem_cylinders hs

/-- A map into `C(U, ℝ)` is measurable as soon as every evaluation is ([Hit26,
Lemma 4.1.5], as used for the random continuous
function `ψ_n`). -/
theorem measurable_of_eval {Ω : Type*} [MeasurableSpace Ω] {g : Ω → C(U, ℝ)}
    (hg : ∀ u, Measurable fun ω ↦ g ω u) : Measurable g := by
  rw [measurable_iff_comap_le]
  change MeasurableSpace.comap g (borel C(U, ℝ)) ≤ _
  rw [borel_eq_generateFrom_cylinders, MeasurableSpace.comap_generateFrom]
  refine MeasurableSpace.generateFrom_le ?_
  rintro _ ⟨_, ⟨M, u, A, hA, rfl⟩, rfl⟩
  exact hA.preimage (Measurable.of_eval fun j ↦ hg (u j))

/-- [Hit26, Lemma 4.1.2] applied to the cylinder sets: two
probability measures on `C(U, ℝ)` with the same finite-dimensional distributions are equal. -/
theorem _root_.MeasureTheory.Measure.ext_of_fdd {μ ν : Measure C(U, ℝ)} [IsProbabilityMeasure μ]
    [IsProbabilityMeasure ν]
    (h : ∀ (M : ℕ) (u : Fin M → U), μ.map (finiteEval u) = ν.map (finiteEval u)) : μ = ν := by
  refine ext_of_generate_finite (cylinders U)
    (BorelSpace.measurable_eq.trans borel_eq_generateFrom_cylinders) isPiSystem_cylinders ?_
    (by simp)
  rintro _ ⟨M, u, A, hA, rfl⟩
  rw [← Measure.map_apply (measurable_finiteEval u) hA,
    ← Measure.map_apply (measurable_finiteEval u) hA, h]

end ContinuousMap
